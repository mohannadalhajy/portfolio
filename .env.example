# Resend API key used by the /api/contact route to email form submissions.
# Get one at https://resend.com/api-keys
RESEND_API_KEY=

# Upstash Redis, used to rate-limit /api/contact. If unset, rate limiting is
# disabled rather than blocking submissions.
#
# Adding the "Upstash for Redis" integration from the Vercel Marketplace
# populates KV_REST_API_URL / KV_REST_API_TOKEN (its legacy Vercel KV naming)
# automatically for Production/Preview. For local dev, create a database at
# https://console.upstash.com and copy its REST URL/token into either pair
# below — both are supported.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=